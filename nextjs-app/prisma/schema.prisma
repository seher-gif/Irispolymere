// Iris Polymere admin CMS — local SQLite database.
// Blog posts/categories/media are authored here and read by the public
// site at build time (SSG). Run `npm run build` after publishing changes
// so the live deployment picks them up.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameFr    String
  nameAr    String
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  titleEn     String
  titleFr     String?
  titleAr     String?
  excerptEn   String
  excerptFr   String?
  excerptAr   String?
  bodyEn      String // rich text HTML from the Tiptap editor
  bodyFr      String?
  bodyAr      String?

  coverImage  String? // relative /uploads path

  // SEO — optional overrides. When blank, the public site falls back to
  // title / excerpt (see lib/seo.ts + the blog detail page).
  metaTitleEn       String?
  metaTitleFr       String?
  metaTitleAr       String?
  metaDescriptionEn String?
  metaDescriptionFr String?
  metaDescriptionAr String?

  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         String // "pdf" | "image"
  url          String // relative /uploads path
  altText      String? // accessibility/SEO alt text for images; unused for PDFs
  uploadedAt   DateTime @default(now())
}

// Homepage hero banners — 1 to 5, rotate on the public site. Enforced in
// lib/actions/banners.ts (max 5 on create, min 1 on delete), not here.
model Banner {
  id        String   @id @default(cuid())
  url       String // relative /uploads path
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id              String   @id @default(cuid())
  fullName        String
  company         String
  country         String
  email           String
  phone           String?
  productInterest String
  message         String
  locale          String // which language the visitor submitted from
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Admin-editable SEO overrides for static (non-blog) pages — home, corporate,
// products, certificates, contact. `key` matches an entry in
// lib/data/page-registry.ts (e.g. "home", "corporate/about", "products/pvc-rigid").
// Any field left blank falls back to that page's dictionary-driven default.
model PageMeta {
  id                String   @id @default(cuid())
  key               String   @unique
  metaTitleEn       String?
  metaTitleFr       String?
  metaTitleAr       String?
  metaDescriptionEn String?
  metaDescriptionFr String?
  metaDescriptionAr String?
  updatedAt         DateTime @updatedAt
}

model Certificate {
  id        String   @id @default(cuid())
  key       String   @unique // "iso" | "eco" | "reach" | "rohs"
  titleEn   String
  titleFr   String
  titleAr   String
  descEn    String
  descFr    String
  descAr    String
  pdfUrl    String? // relative /uploads path once the client-supplied PDF is added
  updatedAt DateTime @updatedAt
}
