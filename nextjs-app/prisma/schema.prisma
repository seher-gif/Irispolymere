// Iris Polymere admin CMS — local SQLite database.
// Blog posts/categories/media are authored here and read by the public
// site at build time (SSG). Run `npm run build` after publishing changes
// so the live deployment picks them up.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameFr    String
  nameAr    String
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  titleEn     String
  titleFr     String?
  titleAr     String?
  excerptEn   String
  excerptFr   String?
  excerptAr   String?
  bodyEn      String // rich text HTML from the Tiptap editor
  bodyFr      String?
  bodyAr      String?

  // Locale-specific — the source photography has language text baked in.
  // French/Arabic fall back to the English image at export time if blank.
  coverImageEn String? // relative /uploads path
  coverImageFr String?
  coverImageAr String?

  // SEO — optional overrides. When blank, the public site falls back to
  // title / excerpt (see lib/seo.ts + the blog detail page).
  metaTitleEn       String?
  metaTitleFr       String?
  metaTitleAr       String?
  metaDescriptionEn String?
  metaDescriptionFr String?
  metaDescriptionAr String?

  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         String // "pdf" | "image"
  url          String // relative /uploads path
  altText      String? // accessibility/SEO alt text for images; unused for PDFs
  uploadedAt   DateTime @default(now())
}

// Site-wide brand assets (logo, favicon, OG image, QR code) — one row per
// fixed `key` (see lib/data/site-asset-registry.ts). Overrides the bundled
// default in public/brand/ when present. favicon/apple-icon are additionally
// mirrored to app/icon.png / app/apple-icon.png at upload time, since Next's
// icon convention reads those files directly at build time.
model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String // relative /uploads path
  updatedAt DateTime @updatedAt
}

// Homepage hero banners — 1 to 5, rotate on the public site. Enforced in
// lib/actions/banners.ts (max 5 on create, min 1 on delete), not here.
// Each banner's artwork has locale-specific text baked in, so it's uploaded
// per language; French/Arabic fall back to the English image at export time
// if left blank (same convention as Post's localized text fields).
model Banner {
  id         String   @id @default(cuid())
  urlEn      String // relative /uploads path
  urlFr      String?
  urlAr      String?
  altTextEn  String?
  altTextFr  String?
  altTextAr  String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

// Hero image for a corporate page (currently only "about") — locale-specific
// like Banner, with the same English-fallback convention at export time.
model CorporateHeroImage {
  id        String   @id @default(cuid())
  slug      String   @unique
  urlEn     String
  urlFr     String?
  urlAr     String?
  updatedAt DateTime @updatedAt
}

// Background photo for a page's navy PageHero band (currently the 5 Corporate
// pages, keyed by corporate slug). One image per page, not locale-specific —
// the page title/lead are rendered on top by the site, so the artwork carries
// no text. Falls back to the plain navy band when no row exists.
model PageHeroImage {
  id        String   @id @default(cuid())
  slug      String   @unique
  url       String
  updatedAt DateTime @updatedAt
}

// Real product photography, one image per product slug (see
// lib/data/products.ts). Not locale-specific — these are plain product
// shots with no on-image text. Falls back to the IndustrialVisual SVG
// placeholder on the public site when no row exists for a slug.
model ProductImage {
  id        String   @id @default(cuid())
  slug      String   @unique
  url       String
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id              String   @id @default(cuid())
  fullName        String
  company         String
  country         String
  email           String
  phone           String?
  productInterest String
  message         String
  locale          String // which language the visitor submitted from
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Admin-editable SEO overrides for static (non-blog) pages — home, corporate,
// products, certificates, contact. `key` matches an entry in
// lib/data/page-registry.ts (e.g. "home", "corporate/about", "products/pvc-rigid").
// Any field left blank falls back to that page's dictionary-driven default.
model PageMeta {
  id                String   @id @default(cuid())
  key               String   @unique
  metaTitleEn       String?
  metaTitleFr       String?
  metaTitleAr       String?
  metaDescriptionEn String?
  metaDescriptionFr String?
  metaDescriptionAr String?
  updatedAt         DateTime @updatedAt
}

// Generic key-value store for small site-wide settings (currently just the
// contact-form notification address). Add new settings here by key rather
// than a new model/migration each time.
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Certificate {
  id        String   @id @default(cuid())
  key       String   @unique // "iso" | "eco" | "reach" | "rohs"
  titleEn   String
  titleFr   String
  titleAr   String
  descEn    String
  descFr    String
  descAr    String
  pdfUrl    String? // relative /uploads path once the client-supplied PDF is added
  updatedAt DateTime @updatedAt
}
